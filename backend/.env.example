# =================================================================
# ANJANA CONNECTS — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and supply actual values for your deployment.
# NEVER commit the real .env file with secrets to source control.
# =================================================================

# MongoDB Connection
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=anjana_connects

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS Configuration (comma-separated origins allowed)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Anjana Connects

# Password Reset Configuration
PASSWORD_RESET_EXPIRE_MINUTES=15
